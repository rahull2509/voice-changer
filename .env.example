# Voice Changer Configuration
# Copy to .env and modify as needed

# Server
HOST=127.0.0.1
PORT=8000

# Audio devices (use GET /audio/devices to find IDs)
# Leave blank for system defaults
INPUT_DEVICE=
OUTPUT_DEVICE=

# Mode: "dsp" or "rvc"
MODE=dsp

# DSP settings
DSP_ENGINE=world
DSP_PITCH_FACTOR=1.6
DSP_FORMANT_SHIFT=1.15
DSP_OUTPUT_GAIN=0.85
DSP_DRY_WET_MIX=1.0

# Audio pipeline
INTERNAL_SAMPLE_RATE=16000
CHUNK_DURATION_MS=300
PAD_DURATION_MS=150
CROSSFADE_MS=10

# RVC AI mode (Phase 2)
RVC_MODEL_PATH=
RVC_INDEX_PATH=
RVC_HUBERT_PATH=models/hubert_base.pt
RVC_PITCH_SHIFT_SEMITONES=12
